# Set these values in the process or deployment environment. Keep credentials out of source control.
# Stable random secret, at least 32 bytes; keeps signed browser artifacts valid after restart.
FWMIGRATE_WORKSPACE_SIGNING_KEY=


# Hosted web authentication. Set a password when hosted authentication is required.
# The browser uses HTTP Basic authentication; keep this value out of source control.
FWMIGRATE_WEB_USERNAME=fwmigrate
FWMIGRATE_WEB_PASSWORD=

# Remote network actions fail closed unless explicitly enabled on an authenticated server.
FWMIGRATE_ALLOW_REMOTE_COLLECTION=0
FWMIGRATE_ALLOW_REMOTE_DEPLOYMENT=0

# Process-local API controls. Use one Gunicorn worker. Values must be positive integers.
FWMIGRATE_API_RATE_LIMIT_PER_MINUTE=30
FWMIGRATE_MAX_CONCURRENT_REQUESTS=2
