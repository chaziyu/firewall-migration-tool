# Copy to .env.local. Keep local credentials out of source control.
GROQ_API_KEY=
FWMIGRATE_AI_ENABLED=0
FWMIGRATE_AI_SIMPLE_MODEL=openai/gpt-oss-20b
FWMIGRATE_AI_COMPLEX_MODEL=openai/gpt-oss-120b
FWMIGRATE_AI_REPAIR_MODEL=openai/gpt-oss-120b
FWMIGRATE_AI_MAX_BATCH=2
FWMIGRATE_AI_MAX_REQUEST_BYTES=49152
FWMIGRATE_AI_MAX_CANDIDATES_PER_DECISION=64
FWMIGRATE_AI_MAX_COMPLETION_TOKENS=4096
FWMIGRATE_AI_REASONING_EFFORT=medium
FWMIGRATE_AI_REASONING_FORMAT=hidden
FWMIGRATE_AI_LOCAL_URL=
FWMIGRATE_AI_LOCAL_MODEL=Qwen/Qwen3-0.6B
FWMIGRATE_AI_LOCAL_RESPONSE_MODE=STRICT_SCHEMA
FWMIGRATE_AI_GUARD_MODEL=
FWMIGRATE_AI_TIMEOUT_SECONDS=30
