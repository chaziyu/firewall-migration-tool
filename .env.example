# Set these values in the process or deployment environment. Keep secrets out of source control.
# Stable random secret, at least 32 bytes; keeps signed browser artifacts valid after restart.
FWMIGRATE_WORKSPACE_SIGNING_KEY=


# Public file processing requires no login and blocks all live device operations.
# The loopback-only `fwmigrate serve` launcher selects local mode automatically.
FWMIGRATE_WEB_MODE=public

# Optional comma-separated exact hostnames, without schemes or ports.
# Empty uses loopback hosts and the documented Render hostname.
FWMIGRATE_ALLOWED_HOSTS=

# Process-local API controls. Use one Gunicorn worker. Values must be positive integers.
FWMIGRATE_API_RATE_LIMIT_PER_MINUTE=30
FWMIGRATE_MAX_CONCURRENT_REQUESTS=2
