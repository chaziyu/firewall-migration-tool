# Copy to .env.local. Keep local credentials out of source control.
GROQ_API_KEY=
FWMIGRATE_AI_ENABLED=0
FWMIGRATE_AI_SIMPLE_MODEL=openai/gpt-oss-20b
FWMIGRATE_AI_COMPLEX_MODEL=openai/gpt-oss-120b
FWMIGRATE_AI_REPAIR_MODEL=openai/gpt-oss-120b
FWMIGRATE_AI_MAX_BATCH=2
FWMIGRATE_AI_MAX_REQUEST_BYTES=24576
FWMIGRATE_AI_MAX_CANDIDATES_PER_DECISION=12
FWMIGRATE_AI_MAX_COMPLETION_TOKENS=1536
FWMIGRATE_AI_REASONING_EFFORT=medium
FWMIGRATE_AI_REASONING_FORMAT=hidden
FWMIGRATE_AI_MAX_RETRY_DELAY_SECONDS=10
FWMIGRATE_AI_COMPLEX_CANDIDATE_THRESHOLD=3
FWMIGRATE_AI_LOCAL_URL=
FWMIGRATE_AI_LOCAL_MODEL=Qwen/Qwen3-0.6B
FWMIGRATE_AI_LOCAL_RESPONSE_MODE=STRICT_SCHEMA
FWMIGRATE_AI_GUARD_MODEL=
FWMIGRATE_AI_TIMEOUT_SECONDS=30

# Stable random secret, at least 32 bytes; keeps signed browser artifacts valid after restart.
FWMIGRATE_WORKSPACE_SIGNING_KEY=


# Hosted Docker/web authentication. Docker requires a non-empty password.
# The browser uses HTTP Basic authentication; keep this value out of source control.
FWMIGRATE_WEB_USERNAME=fwmigrate
FWMIGRATE_WEB_PASSWORD=
