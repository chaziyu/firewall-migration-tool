set version 21.4R1.12
set system host-name SRX-Interfaces
set interfaces ge-0/0/0 description "Uplink to Core"
set interfaces ge-0/0/0 unit 0 description "Primary LAN"
set interfaces ge-0/0/0 unit 0 family inet address 10.10.1.1/24 primary
set interfaces ge-0/0/0 unit 0 family inet address 10.10.1.2/24
set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8:1::1/64
set interfaces ge-0/0/0 unit 10 description "Voice VLAN"
set interfaces ge-0/0/0 unit 10 vlan-id 10
set interfaces ge-0/0/0 unit 10 family inet address 10.10.10.1/24
set interfaces ge-0/0/1 description "WAN Interface"
set interfaces ge-0/0/1 unit 0 family inet address 198.51.100.10/24
set interfaces ge-0/0/2 disable
set security zones security-zone trust interfaces ge-0/0/0.0
set security zones security-zone trust interfaces ge-0/0/0.10
set security zones security-zone untrust interfaces ge-0/0/1.0
set security zones security-zone dmz description "DMZ Isolated Zone"
set security zones security-zone dmz host-inbound-traffic system-services [ ping ssh ]
set security zones security-zone dmz host-inbound-traffic protocols [ ospf bgp ]
set security zones security-zone dmz screen untrust-screen
