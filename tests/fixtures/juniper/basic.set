set version 21.4R1.12
set system host-name SRX-Branch-01
set system time-zone America/New_York
set system name-server 8.8.8.8
set system name-server 8.8.4.4
set security zones security-zone trust interfaces ge-0/0/0.0
set security zones security-zone untrust interfaces ge-0/0/1.0
set security address-book global address srv_db 10.0.1.10/32
set security address-book global address net_lan 10.0.0.0/24
set security policies from-zone trust to-zone untrust policy Allow_Outbound match source-address net_lan
set security policies from-zone trust to-zone untrust policy Allow_Outbound match destination-address any
set security policies from-zone trust to-zone untrust policy Allow_Outbound match application any
set security policies from-zone trust to-zone untrust policy Allow_Outbound then permit
set routing-options static route 0.0.0.0/0 next-hop 198.51.100.1
