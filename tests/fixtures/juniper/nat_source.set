set version 21.4R1.12
set system host-name SRX-SourceNAT
set security zones security-zone trust interfaces ge-0/0/0.0
set security zones security-zone untrust interfaces ge-0/0/1.0
set security nat source pool src_pool_1 address [ 198.51.100.50/32 198.51.100.51/32 ]
set security nat source pool src_pool_1 port [ 5000 to 6000 ]
set security nat source rule-set rs_trust_to_untrust from zone trust
set security nat source rule-set rs_trust_to_untrust to zone untrust
set security nat source rule-set rs_trust_to_untrust rule r1 match source-address 10.0.0.0/24
set security nat source rule-set rs_trust_to_untrust rule r1 match destination-address 0.0.0.0/0
set security nat source rule-set rs_trust_to_untrust rule r1 then source-nat pool src_pool_1
set security nat source rule-set rs_trust_to_untrust rule r2_interface match source-address 10.1.0.0/24
set security nat source rule-set rs_trust_to_untrust rule r2_interface match destination-address 0.0.0.0/0
set security nat source rule-set rs_trust_to_untrust rule r2_interface then source-nat interface
set security nat source rule-set rs_trust_to_untrust rule r3_off match source-address 10.2.0.0/24
set security nat source rule-set rs_trust_to_untrust rule r3_off match destination-address 10.3.0.0/24
set security nat source rule-set rs_trust_to_untrust rule r3_off then source-nat off
