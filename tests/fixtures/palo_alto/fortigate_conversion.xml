<config version="11.1.0"><devices><entry name="fw1">
<network><interface><ethernet>
<entry name="ethernet1/1"><layer3><ip><entry name="10.0.0.1/24"/></ip></layer3></entry>
<entry name="ethernet1/2"><layer3><ip><entry name="192.0.2.1/24"/></ip></layer3></entry>
</ethernet></interface></network>
<vsys><entry name="vsys1"><import><network><interface><member>ethernet1/1</member><member>ethernet1/2</member></interface></network></import>
<address><entry name="net"><ip-netmask>10.0.0.0/24</ip-netmask></entry></address>
<address-group><entry name="clients"><static><member>net</member></static></entry></address-group>
<service><entry name="web"><protocol><tcp><port>443</port><source-port>1024-65535</source-port></tcp></protocol></entry></service>
<zone><entry name="trust"><network><layer3><member>ethernet1/1</member></layer3></network></entry><entry name="untrust"><network><layer3><member>ethernet1/2</member></layer3></network></entry></zone>
<rulebase><security><rules><entry name="allow-web"><from><member>trust</member></from><to><member>untrust</member></to><source><member>clients</member></source><destination><member>any</member></destination><source-user><member>any</member></source-user><application><member>any</member></application><service><member>web</member></service><category><member>any</member></category><action>allow</action><rule-type>universal</rule-type><negate-source>no</negate-source><negate-destination>no</negate-destination><disabled>no</disabled><log-start>no</log-start><log-end>yes</log-end></entry></rules></security></rulebase>
</entry></vsys></entry></devices></config>