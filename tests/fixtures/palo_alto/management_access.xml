<config version="11.1.0">
  <devices>
    <entry name="pa-fw-01">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <layer3>
                <ip><entry name="192.0.2.1/24" /></ip>
                <interface-management-profile>allow-admin</interface-management-profile>
              </layer3>
            </entry>
          </ethernet>
        </interface>
        <profiles>
          <interface-management-profile>
            <entry name="allow-admin">
              <ping>yes</ping>
              <ssh>yes</ssh>
              <permitted-ip>
                <entry name="admin-net" />
              </permitted-ip>
              <future-management-setting><enabled>yes</enabled></future-management-setting>
            </entry>
          </interface-management-profile>
        </profiles>
      </network>
      <deviceconfig>
        <system>
          <ip-address>198.51.100.10</ip-address>
          <netmask>255.255.255.0</netmask>
          <default-gateway>198.51.100.1</default-gateway>
          <permitted-ip>
            <entry name="admin-net"><description>Management network</description></entry>
          </permitted-ip>
          <service>
            <disable-http>yes</disable-http>
          </service>
        </system>
      </deviceconfig>
    </entry>
  </devices>
</config>
