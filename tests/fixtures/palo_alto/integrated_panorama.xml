<config version="11.1.0"><shared>
  <address><entry name="shared-net"><ip-netmask>10.0.0.0/8</ip-netmask></entry><entry name="shadowed"><ip-netmask>192.0.2.1/32</ip-netmask></entry></address>
  <service><entry name="shared-https"><protocol><tcp><port>443</port></tcp></protocol></entry></service>
  <profile-group><entry name="shared-profiles"><virus><member>default</member></virus></entry></profile-group>
  <pre-rulebase><security><rules><entry name="shared-pre"><from><member>any</member></from><to><member>any</member></to><source><member>shared-net</member></source><destination><member>any</member></destination><application><member>web-browsing</member></application><service><member>shared-https</member></service><action>allow</action></entry></rules></security><nat><rules><entry name="shared-nat-pre"><from><member>any</member></from><to><member>any</member></to><source><member>shared-net</member></source><destination><member>any</member></destination><service>any</service></entry></rules></nat></pre-rulebase>
  <post-rulebase><security><rules><entry name="shared-post"><from><member>any</member></from><to><member>any</member></to><source><member>any</member></source><destination><member>any</member></destination><application><member>any</member></application><service><member>any</member></service><action>deny</action></entry></rules></security></post-rulebase>
  <rulebase><default-security-rules><rules><entry name="intrazone-default"/><entry name="interzone-default"/></rules></default-security-rules></rulebase>
</shared><devices><entry name="panorama"><device-group>
  <entry name="parent"><address><entry name="shadowed"><ip-netmask>10.1.0.1/32</ip-netmask></entry></address><profile-group><entry name="parent-profiles"><virus><member>parent-av</member></virus></entry></profile-group>
    <pre-rulebase><security><rules><entry name="parent-pre"><from><member>any</member></from><to><member>any</member></to><source><member>shadowed</member></source><destination><member>any</member></destination><application><member>ssl</member></application><service><member>shared-https</member></service><profile-setting><group><member>parent-profiles</member></group></profile-setting><action>allow</action></entry></rules></security></pre-rulebase>
    <post-rulebase><security><rules><entry name="parent-post"><from><member>any</member></from><to><member>any</member></to><source><member>any</member></source><destination><member>any</member></destination><application><member>any</member></application><service><member>any</member></service><action>deny</action></entry></rules></security></post-rulebase>
  </entry>
  <entry name="child"><parent-dg>parent</parent-dg><devices><entry name="serial-child"><vsys><entry name="vsys1"/></vsys></entry></devices><address><entry name="shadowed"><ip-netmask>10.2.0.1/32</ip-netmask></entry></address><profile-group><entry name="child-profiles"><virus><member>child-av</member></virus></entry></profile-group>
    <pre-rulebase><security><rules><entry name="child-pre"><from><member>any</member></from><to><member>any</member></to><source><member>shadowed</member></source><destination><member>any</member></destination><application><member>ssl</member></application><service><member>shared-https</member></service><profile-setting><group><member>child-profiles</member></group></profile-setting><action>allow</action></entry></rules></security><nat><rules><entry name="child-nat"><from><member>any</member></from><to><member>any</member></to><source><member>shadowed</member></source><destination><member>any</member></destination><service>any</service></entry></rules></nat></pre-rulebase>
    <post-rulebase><security><rules><entry name="child-post"><from><member>any</member></from><to><member>any</member></to><source><member>any</member></source><destination><member>any</member></destination><application><member>any</member></application><service><member>any</member></service><action>deny</action></entry></rules></security><future-policy><rules><entry name="future-child"><setting>retain-panorama-evidence</setting></entry></rules></future-policy></post-rulebase>
    <rulebase><default-security-rules><rules><entry name="interzone-default"><log-end>yes</log-end></entry></rules></default-security-rules></rulebase>
  </entry>
</device-group></entry></devices></config>
