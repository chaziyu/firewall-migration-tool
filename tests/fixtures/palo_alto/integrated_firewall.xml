<config version="11.1.0"><devices><entry name="integrated-fw"><deviceconfig><system><hostname>integrated-fw</hostname></system></deviceconfig><network>
  <interface><ethernet><entry name="ethernet1/1"><layer3><ip><entry name="10.0.0.1/24"/></ip></layer3></entry><entry name="ethernet1/2"><layer2><units><entry name="ethernet1/2.20"><tag>20</tag></entry></units></layer2></entry></ethernet><aggregate-ethernet><entry name="ae1"><layer3><ip><entry name="192.0.2.1/30"/></ip></layer3></entry></aggregate-ethernet><loopback><units><entry name="loopback.1"><ip><entry name="10.255.0.1/32"/></ip></entry></units></loopback><tunnel><units><entry name="tunnel.1"><ip><entry name="169.254.1.1/30"/></ip></entry></units></tunnel></interface>
  <virtual-router><entry name="vr-main"><interface><member>ethernet1/1</member><member>ae1</member></interface><routing-table><ip><static-route><entry name="default"><destination>0.0.0.0/0</destination><nexthop><ip-address>192.0.2.2</ip-address></nexthop><interface>ae1</interface><metric>10</metric></entry></static-route></ip></routing-table><protocol><bgp><enable>yes</enable><router-id>10.255.0.1</router-id><local-as>65001</local-as><peer-group><entry name="upstream"><peer><entry name="isp"><peer-as>65002</peer-as><peer-address><ip>192.0.2.2</ip></peer-address></entry></peer></entry></peer-group></bgp><ospf><enable>yes</enable><router-id>10.255.0.1</router-id><area><entry name="0.0.0.0"><interface><entry name="ethernet1/1"><metric>10</metric></entry></interface></entry></area></ospf></protocol></entry></virtual-router>
  <future-network><entry name="future-net"><material>retain-network-evidence</material></entry></future-network>
  </network><vsys><entry name="vsys1"><import><network><interface><member>ethernet1/1</member><member>ae1</member></interface><virtual-router><member>vr-main</member></virtual-router></network></import>
    <zone><entry name="trust"><network><layer3><member>ethernet1/1</member></layer3></network></entry><entry name="untrust"><network><layer3><member>ae1</member></layer3></network></entry></zone>
    <address><entry name="inside"><ip-netmask>10.0.0.0/24</ip-netmask></entry><entry name="public"><ip-netmask>203.0.113.10/32</ip-netmask></entry></address>
    <address-group><entry name="inside-group"><static><member>inside</member></static></entry></address-group>
    <service><entry name="https"><protocol><tcp><port>443</port></tcp></protocol></entry></service><service-group><entry name="web-services"><members><member>https</member></members></entry></service-group>
    <profile-group><entry name="strict-profiles"><virus><member>default</member></virus></entry></profile-group>
    <rulebase><security><rules><entry name="allow-web"><from><member>trust</member></from><to><member>untrust</member></to><source><member>inside-group</member></source><destination><member>public</member></destination><application><member>ssl</member></application><service><member>web-services</member></service><profile-setting><group><member>strict-profiles</member></group></profile-setting><action>allow</action></entry></rules></security>
      <default-security-rules><rules><entry name="intrazone-default"/><entry name="interzone-default"><log-end>yes</log-end></entry></rules></default-security-rules>
      <nat><rules><entry name="outbound"><from><member>trust</member></from><to><member>untrust</member></to><source><member>inside-group</member></source><destination><member>any</member></destination><service>any</service><source-translation><dynamic-ip-and-port><interface-address><interface>ae1</interface></interface-address></dynamic-ip-and-port></source-translation></entry></rules></nat>
      <future-policy><rules><entry name="future-rule"><material>retain-policy-evidence</material></entry></rules></future-policy>
    </rulebase>
  </entry></vsys></entry></devices></config>
